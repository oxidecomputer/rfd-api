{
  "author": "Oxide Computer Company",
  "bugs": {
    "url": "https://github.com/oxidecomputer/rfd-api/issues"
  },
  "description": "TypeScript client for the RFD API",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./client": {
      "import": "./dist/Api.js",
      "require": "./dist/Api.cjs"
    },
    "./client-retry": {
      "import": "./dist/retry.js",
      "require": "./dist/retry.cjs"
    },
    "./validation": {
      "import": "./dist/validate.js",
      "require": "./dist/validate.cjs"
    }
  },
  "homepage": "https://github.com/oxidecomputer/rfd-api#readme",
  "keywords": [],
  "license": "MPL-2.0",
  "name": "@oxide/rfd.ts",
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxidecomputer/rfd-api.git"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tsc": "tsc"
  },
  "type": "module",
  "typesVersions": {
    "*": {
      "client": [
        "dist/Api.d.ts"
      ],
      "client-retry": [
        "dist/retry.d.ts"
      ],
      "validation": [
        "dist/validate.d.ts"
      ]
    }
  },
  "version": "0.15.5"
}
